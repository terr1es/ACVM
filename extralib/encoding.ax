//  encoding.ax — text encodings that are not UTF-8, and byte-order marks.
//
//      function import (return:(encoding));
//
//      ptr Decoded enc = decodeText(bytes, length);
//      print(enc->name);      // "UTF-16LE", "windows-1252", "UTF-8" …
//      print(enc->text);      // always UTF-8 from here on
//
//  ── the failure this prevents ─────────────────────────────────────────────
//
//  A CSV exported from Excel on Windows is UTF-16LE. Read it as bytes and every
//  character arrives as `letter, 0x00` -- the program does not fail, it produces
//  text with NUL padding that parses into nonsense. The same happens with `.reg`
//  files, some CSV exports from Japanese Excel (UTF-16BE is rare but real), and
//  anything a Windows tool wrote with `-Encoding Unicode`.
//
//  So the rule for a file reader is: look at the first bytes, and if they say the
//  text is not UTF-8, convert before anything else touches it. Doing that inside
//  `docReadFile` means all seven format parsers get it for free.
//
//  ── what is detected ──────────────────────────────────────────────────────
//
//  By BOM, in this order (the order matters: UTF-32LE starts with the UTF-16LE
//  BOM, so it has to be tested first):
//
//      EF BB BF      UTF-8, BOM stripped
//      FF FE 00 00   UTF-32LE
//      00 00 FE FF   UTF-32BE
//      FF FE         UTF-16LE
//      FE FF         UTF-16BE
//
//  Without a BOM, a heuristic is used only when the evidence is overwhelming,
//  because guessing wrong silently is worse than passing bytes through:
//
//      every other byte is 0x00 over the first 64 bytes   -> UTF-16 (LE or BE)
//      otherwise                                           -> as-is
//
//  That is how UTF-16 without a BOM is caught in practice (ASCII-heavy text), and
//  it never triggers on UTF-8, whose continuation bytes are never 0x00.
//
//  ── what is not detected ──────────────────────────────────────────────────
//
//  Legacy single-byte code pages other than the explicit `latin1ToUtf8` helper.
//  Detecting cp1252 vs cp1251 vs cp437 from the bytes alone is impossible in
//  general -- `0xE9` is `é` in all of them and something else in others. A program
//  that knows it reads a specific code page calls the converter for it; that is a
//  decision only the caller can make.

//  depends: (none)

module "encoding" version "0.1.0";

//  No imports: this module works on bytes and builds its own UTF-8, so `value` can
//  depend on it (for `docReadFile`) without a cycle.

comptime int kEncodingSniffBytes = 64;

struct Decoded {
    string text;       // always UTF-8
    string name;       // the encoding the input was in, for logging
    bool converted;    // false when the input was already UTF-8
    bool hadBom;       // true when a byte-order mark was present and removed
};

//===--- BOM --------------------------------------------------------------===//

function private byteAtOr(ptr unsigned int8 bytes, int length, int index):int {
    if (index < 0 || index >= length) {
        return -1;
    }
    return @(bytes + index) as int;
    eof: pass;
}

//  Length of the BOM at the start, or 0. `*kind` receives an index identifying
//  which one it was: 1 UTF-8, 2 UTF-16LE, 3 UTF-16BE, 4 UTF-32LE, 5 UTF-32BE.
function bomLength(ptr unsigned int8 bytes, int length, ptr int kind):int {
    @kind = 0;
    if (length >= 4) {
        int b0 = @(bytes) as int;
        int b1 = @(bytes + 1) as int;
        int b2 = @(bytes + 2) as int;
        int b3 = @(bytes + 3) as int;
        if (b0 == 255 && b1 == 254 && b2 == 0 && b3 == 0) {
            @kind = 4;
            return 4;
        }
        if (b0 == 0 && b1 == 0 && b2 == 254 && b3 == 255) {
            @kind = 5;
            return 4;
        }
    }
    if (length >= 3) {
        if (@(bytes) as int == 239 && @(bytes + 1) as int == 187 && @(bytes + 2) as int == 191) {
            @kind = 1;
            return 3;
        }
    }
    if (length >= 2) {
        int b0 = @(bytes) as int;
        int b1 = @(bytes + 1) as int;
        if (b0 == 255 && b1 == 254) {
            @kind = 2;
            return 2;
        }
        if (b0 == 254 && b1 == 255) {
            @kind = 3;
            return 2;
        }
    }
    return 0;
    eof: pass;
}

//===--- UTF-8 building blocks -------------------------------------------===//

//  Appends one code point as UTF-8. Kept local so this module has no dependency
//  on `value`'s builder; the copy is twelve lines and removes a whole layer from
//  the dependency graph.
function private putUtf8(ptr unsigned int8 out, int offset, int code):int {
    if (code < 0 || code > 1114111 || (code >= 55296 && code <= 57343)) {
        code = 65533;      // U+FFFD, so unpaired surrogates cannot escape
    }
    if (code < 128) {
        @(out + offset) = code as unsigned int8;
        return 1;
    }
    if (code < 2048) {
        @(out + offset) = (192 | (code >> 6)) as unsigned int8;
        @(out + offset + 1) = (128 | (code & 63)) as unsigned int8;
        return 2;
    }
    if (code < 65536) {
        @(out + offset) = (224 | (code >> 12)) as unsigned int8;
        @(out + offset + 1) = (128 | ((code >> 6) & 63)) as unsigned int8;
        @(out + offset + 2) = (128 | (code & 63)) as unsigned int8;
        return 3;
    }
    @(out + offset) = (240 | (code >> 18)) as unsigned int8;
    @(out + offset + 1) = (128 | ((code >> 12) & 63)) as unsigned int8;
    @(out + offset + 2) = (128 | ((code >> 6) & 63)) as unsigned int8;
    @(out + offset + 3) = (128 | (code & 63)) as unsigned int8;
    return 4;
    eof: pass;
}

//===--- UTF-16 -----------------------------------------------------------===//

//  Converts UTF-16 to UTF-8. `bigEndian` selects the byte order.
//
//  Surrogate pairs are combined properly: a high surrogate followed by a low one is
//  one code point (and encodes to four UTF-8 bytes), while an unpaired surrogate
//  becomes U+FFFD. Writing each half separately would produce the "CESU-8" bytes
//  that no reader accepts -- which is exactly what a naive converter does.
//
//  An odd trailing byte is dropped: it cannot be half a code unit, and keeping it
//  would shift the whole output.
function utf16ToUtf8(ptr unsigned int8 bytes, int length, bool bigEndian):string {
    if (length < 2) {
        return "";
    }
    // Worst case is 3 bytes out per 2 in; surrogate pairs give 4 per 4, so this is
    // an upper bound for both.
    int capacity = (length / 2) * 3 + 8;
    ptr unsigned int8 out = alloc(capacity) as ptr unsigned int8;
    if (out == null) {
        return "";
    }
    int used = 0;
    int i = 0;
    while (i + 1 < length) {
        int unit = 0;
        if (bigEndian) {
            unit = ((@(bytes + i) as int) << 8) | (@(bytes + i + 1) as int);
        } else {
            unit = (@(bytes + i) as int) | ((@(bytes + i + 1) as int) << 8);
        }
        i = i + 2;

        if (unit >= 55296 && unit <= 56319) {
            // High surrogate: look for the low one.
            if (i + 1 < length) {
                int low = 0;
                if (bigEndian) {
                    low = ((@(bytes + i) as int) << 8) | (@(bytes + i + 1) as int);
                } else {
                    low = (@(bytes + i) as int) | ((@(bytes + i + 1) as int) << 8);
                }
                if (low >= 56320 && low <= 57343) {
                    i = i + 2;
                    int code = 65536 + ((unit - 55296) << 10) + (low - 56320);
                    used = used + putUtf8(out, used, code);
                    continue;
                }
            }
            used = used + putUtf8(out, used, 65533);
            continue;
        }
        if (unit >= 56320 && unit <= 57343) {
            // A low surrogate with no high one before it.
            used = used + putUtf8(out, used, 65533);
            continue;
        }
        used = used + putUtf8(out, used, unit);
    }
    string result = makeString(out as ptr char, used);
    free(out as ptr void);
    return result;
    eof: pass;
}

//===--- UTF-32 -----------------------------------------------------------===//

//  Converts UTF-32 to UTF-8, dropping the four-byte units Windows writes for
//  text that is almost always ASCII. `bytesAvailable` may not be a multiple of
//  four; the remainder is ignored.
function utf32ToUtf8(ptr unsigned int8 bytes, int length, bool bigEndian):string {
    int capacity = (length / 4) * 2 + 8;
    ptr unsigned int8 out = alloc(capacity) as ptr unsigned int8;
    if (out == null) {
        return "";
    }
    int used = 0;
    int i = 0;
    while (i + 3 < length) {
        int code = 0;
        if (bigEndian) {
            code = ((@(bytes + i) as int) << 24) | ((@(bytes + i + 1) as int) << 16) |
                   ((@(bytes + i + 2) as int) << 8) | (@(bytes + i + 3) as int);
        } else {
            code = (@(bytes + i) as int) | ((@(bytes + i + 1) as int) << 8) |
                   ((@(bytes + i + 2) as int) << 16) | ((@(bytes + i + 3) as int) << 24);
        }
        i = i + 4;
        used = used + putUtf8(out, used, code);
    }
    string result = makeString(out as ptr char, used);
    free(out as ptr void);
    return result;
    eof: pass;
}

//===--- Latin-1 / cp1252 ------------------------------------------------===//

//  Latin-1 (ISO-8859-1) to UTF-8: every byte is a code point, so `0xE9` becomes
//  U+00E9. This is the right conversion for old European data and for the
//  `Content-Type: text/plain; charset=iso-8859-1` case.
//
//  Note what this is *not*: cp1252. The two agree on most bytes, but cp1252 puts
//  printable characters (`€`, `‚`, `„` …) in 0x80..0x9F where Latin-1 has control
//  codes. If the source is Windows-1252 and you convert as Latin-1, those bytes
//  turn into unprintable controls rather than an error -- so `cp1252ToUtf8` exists
//  separately below and is what a Windows export usually needs.
function latin1ToUtf8(ptr unsigned int8 bytes, int length):string {
    ptr unsigned int8 out = alloc(length * 2 + 8) as ptr unsigned int8;
    if (out == null) {
        return "";
    }
    int used = 0;
    int i = 0;
    while (i < length) {
        used = used + putUtf8(out, used, @(bytes + i) as int);
        i = i + 1;
    }
    string result = makeString(out as ptr char, used);
    free(out as ptr void);
    return result;
    eof: pass;
}

//  The 0x80..0x9F block of cp1252, which is the only place it differs from
//  Latin-1. `-1` means "undefined in cp1252"; those bytes stay as the control
//  character the byte number names, because a substitution would invent text.
global int Cp1252High[32] = {
    0x20AC, -1, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021,
    0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, -1, 0x017D, -1,
    -1, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014,
    0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, -1, 0x017E, 0x0178
};

function cp1252ToUtf8(ptr unsigned int8 bytes, int length):string {
    ptr unsigned int8 out = alloc(length * 3 + 8) as ptr unsigned int8;
    if (out == null) {
        return "";
    }
    int used = 0;
    int i = 0;
    while (i < length) {
        int byte = @(bytes + i) as int;
        int code = byte;
        if (byte >= 128 && byte <= 159) {
            int mapped = Cp1252High[byte - 128];
            if (mapped > 0) {
                code = mapped;
            }
        }
        used = used + putUtf8(out, used, code);
        i = i + 1;
    }
    string result = makeString(out as ptr char, used);
    free(out as ptr void);
    return result;
    eof: pass;
}

//===--- sniffing --------------------------------------------------------===//

//  True when the first `kEncodingSniffBytes` bytes look like UTF-16 without a BOM.
//
//  The test is "does a NUL byte appear at all". Valid UTF-8 text cannot contain
//  0x00: it is a control character, it never appears inside a multi-byte sequence,
//  and a text file with NULs is not text any parser should accept. UTF-16, on the
//  other hand, puts one in almost every code unit as soon as the text is ASCII or
//  Latin -- which is most of the file, even when it also contains CJK.
//
//  An earlier version required *every* byte at one parity to be zero, which missed
//  `{"name": "café \u2603"}` in UTF-16 because the accented and non-Latin characters fill
//  both byte positions. Testing for "any NUL" and then deciding the byte order by
//  where the NULs are is both simpler and correct for that case.
//
//  The byte order comes from the parity that holds the zero bytes: ASCII text in
//  UTF-16LE is `letter, 0x00`, so the zeros are at odd offsets.
function looksLikeUtf16(ptr unsigned int8 bytes, int length, ptr bool bigEndian):bool {
    @bigEndian = false;
    int limit = length < kEncodingSniffBytes ? length : kEncodingSniffBytes;
    if (limit < 4) {
        return false;
    }
    int evenZeros = 0;
    int oddZeros = 0;
    int total = 0;
    int i = 0;
    while (i < limit) {
        if (@(bytes + i) as int == 0) {
            total = total + 1;
            if (i % 2 == 0) {
                evenZeros = evenZeros + 1;
            } else {
                oddZeros = oddZeros + 1;
            }
        }
        i = i + 1;
    }
    if (total == 0) {
        return false;
    }
    // Ties mean the text is mostly non-ASCII (CJK has no zero high byte in either
    // order); fall back to little-endian, which is what Windows writes.
    @bigEndian = evenZeros > oddZeros;
    return true;
    eof: pass;
}

//===--- entry point -----------------------------------------------------===//

//  Decodes `bytes` into UTF-8 text, choosing the encoding from the BOM (or, in the
//  one unambiguous case, from the byte pattern).
//
//  The result is heap-allocated with `makeString`; it has no document to live in,
//  because this runs before a document exists. The cost is one copy of the file,
//  which is the price of having every parser downstream see UTF-8.
function decodeText(ptr unsigned int8 bytes, int length):Decoded {
    Decoded result;
    result.text = "";
    result.name = "UTF-8";
    result.converted = false;
    result.hadBom = false;

    if (bytes == null || length <= 0) {
        return result;
    }

    int kind = 0;
    int bom = bomLength(bytes, length, #kind);
    if (bom > 0) {
        result.hadBom = true;
        int body = length - bom;
        ptr unsigned int8 start = bytes + bom;
        if (kind == 1) {
            // UTF-8 with a BOM: strip it, keep the bytes. Re-encoding would be a
            // copy for nothing, but the BOM must not reach a parser.
            result.text = makeString(start as ptr char, body);
            result.name = "UTF-8";
            return result;
        }
        if (kind == 2) {
            result.text = utf16ToUtf8(start, body, false);
            result.name = "UTF-16LE";
            result.converted = true;
            return result;
        }
        if (kind == 3) {
            result.text = utf16ToUtf8(start, body, true);
            result.name = "UTF-16BE";
            result.converted = true;
            return result;
        }
        if (kind == 4) {
            result.text = utf32ToUtf8(start, body, false);
            result.name = "UTF-32LE";
            result.converted = true;
            return result;
        }
        if (kind == 5) {
            result.text = utf32ToUtf8(start, body, true);
            result.name = "UTF-32BE";
            result.converted = true;
            return result;
        }
    }

    bool bigEndian = false;
    if (looksLikeUtf16(bytes, length, #bigEndian)) {
        result.text = utf16ToUtf8(bytes, length, bigEndian);
        result.name = bigEndian ? "UTF-16BE (no BOM)" : "UTF-16LE (no BOM)";
        result.converted = true;
        return result;
    }

    // Already UTF-8 (or close enough that anything else would be a guess). The
    // bytes are copied so the caller does not have to keep the source alive.
    result.text = makeString(bytes as ptr char, length);
    return result;
    eof: pass;
}

//  Convenience wrapper on a `string`: decodes if it carries a BOM or is UTF-16,
//  returns it unchanged otherwise.
function decodeTextString(string text):Decoded {
    return decodeText(strBytesOf(text) as ptr unsigned int8, text.length);
    eof: pass;
}

//  True when `bytes` starts with a byte-order mark of any of the supported kinds.
function hasBom(ptr unsigned int8 bytes, int length):bool {
    int kind = 0;
    return bomLength(bytes, length, #kind) > 0;
    eof: pass;
}
