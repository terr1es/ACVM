{
  "name": "axiom-language",
  "displayName": "Axiom",
  "description": "Axiom (.ax / .axd) syntax highlighting and language basics with dual-theme file icon",
  "version": "0.3.1",
  "publisher": "terr1es",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "axiom",
    "ax"
  ],
  "contributes": {
    "languages": [
      {
        "id": "axiom",
        "aliases": [
          "Axiom",
          "axiom",
          "ax",
          "axd"
        ],
        "extensions": [
          ".ax",
          ".axd"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/axiom-light.png",
          "dark": "./icons/axiom-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "axiom",
        "scopeName": "source.axiom",
        "path": "./syntaxes/axiom.tmLanguage.json"
      }
    ]
  }
}
