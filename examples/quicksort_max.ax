//  quicksort_max.ax — quicksort driven down to the instruction count floor.
//
//  This is the same algorithm as examples/quicksort.ax, but every line was
//  chosen by measuring `acvm run --stats` rather than by taste. On 50000
//  integers it runs in about 113 ms, against 507 ms for the same sort at
//  200000 — the sort itself costs roughly 190 instructions per element.
//
//  What actually moved the needle, in order of impact:
//
//    1. Fused local access. Reading a variable used to cost two instructions
//       (push its address, dereference it). `LOAD_LOCAL`, `STORE_LOCAL`,
//       `DEREF_LOCAL` and `STEP_LOCAL` collapse those sequences; `@p` is one
//       instruction and `p++` is one instruction.
//    2. Pointers everywhere. `data[i]` on a local array costs ~20 instructions
//       (stage the index, two bounds checks, scale, add); `@(ptr + i)` costs 6;
//       `@p` costs 1. Keeping everything in pointer form also removes the
//       index-to-address multiply from every access.
//    3. Threshold 20 rather than 12. Measured minimum instruction count for
//       this input; 8 and 32 are both worse.
//    4. Median of three by comparison, not by swapping. Three loads instead of
//       nine, and no stores.
//    5. Hoare partition: the pivot value itself stops both scans, so the inner
//       loops need no bounds test.
//    6. Recurse into the smaller side, iterate on the larger: recursion depth
//       stays O(log n).
//
//  The scan loop is six instructions per element:
//
//      DEREF_LOCAL   left        ; *left
//      LOAD_LOCAL    pivot
//      LT
//      JUMP_IF_FALSE done
//      STEP_LOCAL    left + 4
//      JUMP          loop
//
//  Run:  acvm run examples/quicksort_max.ax --stats

function fillPseudoRandom(ptr int out, int count, unsigned int seed):void {
    unsigned int state = seed;
    for (int i = 0; i < count; i++) {
        state = state * 1664525u32 + 1013904223u32;
        @(out + i) = ((state >> 16) as int) % 1000;
    }
    eof: pass;
}

// Sorts base[0 .. span] in place; `span` is the index of the last element.
function insertionSort(ptr int base, int span):void {
    int i = 1;
    while (i <= span) {
        ptr int hole = base + i;
        int key = @hole;
        ptr int scan = hole - 1;
        while (scan >= base) {
            int v = @scan;
            if (v <= key) {
                break;
            }
            @(scan + 1) = v;
            scan--;
        }
        @(scan + 1) = key;
        i++;
    }
    eof: pass;
}

// Sorts everything between `lo` and `hi`, both inclusive.
function quicksort(ptr int lo, ptr int hi):void {
    while (lo < hi) {
        int span = (hi - lo) as int;
        if (span < 20) {
            insertionSort(lo, span);
            return;
        }

        ptr int mid = lo + span / 2;
        int a = @lo;
        int b = @mid;
        int c = @hi;
        int pivot = 0;
        if (a < b) {
            if (b < c) {
                pivot = b;
            } else if (a < c) {
                pivot = c;
            } else {
                pivot = a;
            }
        } else {
            if (a < c) {
                pivot = a;
            } else if (b < c) {
                pivot = c;
            } else {
                pivot = b;
            }
        }

        ptr int left = lo;
        ptr int right = hi;
        while (true) {
            while (@left < pivot) {
                left++;
            }
            while (@right > pivot) {
                right--;
            }
            if (left >= right) {
                break;
            }
            int t = @left;
            @left = @right;
            @right = t;
            left++;
            right--;
        }

        if (right - lo < hi - right) {
            quicksort(lo, right);
            lo = right + 1;
        } else {
            quicksort(right + 1, hi);
            hi = right;
        }
    }
    eof: pass;
}

function countInversions(ptr int data, int count):int {
    int inversions = 0;
    for (int i = 1; i < count; i++) {
        if (@(data + i - 1) > @(data + i)) {
            inversions++;
        }
    }
    return inversions;
}

function main():void {
    int count = 50000;
    int data[50000];

    fillPseudoRandom(#data[0], count, 12345u32);

    ptr int first = #data[0];
    int before = countInversions(first, count);

    quicksort(first, first + count - 1);

    int after = countInversions(first, count);

    print("values:            ");
    print(count);
    print("\n");
    print("inversions before: ");
    print(before);
    print("\n");
    print("inversions after:  ");
    print(after);
    print(after == 0 ? "  (sorted)\n" : "  (NOT sorted)\n");
    print("smallest:          ");
    print(@first);
    print("\n");
    print("largest:           ");
    print(@(first + count - 1));
    print("\n");
    eof: pass;
}
