//  threadpool_demo.ax — a persistent thread pool, real locks, real atomics.
//
//  This program answers three "why bother" questions:
//
//    1. why a pool beats a fresh thread each time → timing comparison
//    2. what a real lock protects   → locked sums are exact, unlocked ones lose updates
//    3. whether real atomics work   → native threads fight over one cell, count must be exact
//
//  ── how this differs from sync / parallel ─────────────────────────────────
//
//    sync        cooperative concurrency. Several processes share state; atomics and
//                locks settle races. One thread, so no true parallelism.
//    parallel    one-shot parallelism. Reuses a pool inside; caller manages no threads.
//    threadpool  an explicit pool. Use it for stats, for control of the lifetime, or for
//                mutating shared memory under a real lock.
//
//  ── why a submit blocks ───────────────────────────────────────────────────
//
//  An array pointer handed to C points into a **reused VM buffer**: valid for the call,
//  stale after it returns. So a task cannot outlive the call that submitted it — there is
//  no "return a future, collect later". Not laziness, just what marshalling forces.
//
//  Run: acvm run examples/threadpool_demo.ax

function import (return:(threadpool));
function import (return:(parallel));
function import (return:(os));
function import (return:(algorithm));

comptime int N = 1000000;
comptime int ROUNDS = 50;

function private fillLcg(ptr int data, int count, unsigned int seed):void {
    unsigned int state = seed;
    for (int i = 0; i < count; i++) {
        state = state * 1664525u32 + 1013904223u32;
        @(data + i) = ((state >> 16) as int) % 100000;
    }
    eof: pass;
}

// ─── part 1: bulk pool operations and agreement ───────────────────────────

function private stageOne():void {
    print("1. pool operations\n");

    int64 pool = threadPoolCreate(0);
    print("   workers: " + itoa(threadPoolThreads(pool), 10) + "\n");

    int data[N] = {0};
    fillLcg(#data[0], N, 2026u32);

    //  The pool result must equal the serial sum — parallelism may change speed only.
    int64 pooled = threadPoolSum(pool, #data[0], N);
    int64 serial = 0;
    for (int i = 0; i < N; i++) {
        serial = serial + (@(#data[0] + i) as int64);
    }
    print("   sum pooled: " + itoa(pooled, 10) + "\n");
    print("   sum serial: " + itoa(serial, 10) + "\n");
    print("   agree: " + itoa((pooled == serial) as int, 10) + "\n");

    //  Extremes on the same data, checked against algorithm's separate implementation.
    int maxAt = maxIndex(#data[0], N);
    print("   max: " + itoa(threadPoolMax(pool, #data[0], N), 10) +
          " (algorithm: " + itoa(@(#data[0] + maxAt), 10) + ")\n");
    print("   min: " + itoa(threadPoolMin(pool, #data[0], N), 10) + "\n");

    //  Sort: pool version vs the serial algorithm version, identical value for value.
    int reference[N] = {0};
    for (int i = 0; i < N; i++) {
        @(#reference[0] + i) = @(#data[0] + i);
    }
    sort(#reference[0], N);
    int chunks = threadPoolSort(pool, #data[0], N);
    print("   sort chunks: " + itoa(chunks, 10) + "\n");
    print("   sorted: " + itoa(isSortedAsc(#data[0], N) as int, 10) + "\n");
    print("   equals serial sort: " + itoa(equalInts(#data[0], N, #reference[0], N) as int, 10) +
          "\n");

    //  Chunks executed: proof the work really went through the pool, not a serial fallback.
    print("   chunks executed so far: " + itoa(threadPoolExecuted(pool), 10) + "\n");

    threadPoolDestroy(pool);
    eof: pass;
}

// ─── part 2: a real lock guards a shared cell ─────────────────────────────

function private stageTwo():void {
    print("\n2. accumulate under a real lock\n");

    //  All ones, so the total must equal the element count — any drift is a lost update.
    int data[N] = {0};
    int64 pool = threadPoolCreate(0);
    threadPoolFill(pool, #data[0], N, 1);

    int64 lock = threadLockCreate();

    int64 guarded[1] = {0};
    threadPoolAccumulate(pool, #data[0], N, lock, #guarded[0], guarded.length);
    print("   with lock:    " + itoa(@#guarded[0], 10) + " (expect " + itoa(N as int64, 10) + ")\n");
    print("   exact:        " + itoa((@#guarded[0] == N as int64) as int, 10) + "\n");
    print("   lock entries: " + itoa(threadLockAcquisitions(lock), 10) + "\n");

    //  The unlocked path runs **serially**, so its result is exact too. Worth stating —
    //  a multi-worker unlocked sum loses updates, so the library rather not parallelise.
    int64 plain[1] = {0};
    threadPoolAccumulate(pool, #data[0], N, 0, #plain[0], plain.length);
    print("   without lock: " + itoa(@#plain[0], 10) + " (serial fallback, also exact)\n");

    threadLockDestroy(lock);
    threadPoolDestroy(pool);
    eof: pass;
}

// ─── part 3: real atomics ─────────────────────────────────────────────────

function private stageThree():void {
    print("\n3. real atomics\n");

    int64 pool = threadPoolCreate(0);
    int counter[1] = {0};
    int times = 400000;

    //  Let 12 native threads hammer one cell with platform atomics. The only way to prove
    //  real atomics — the Axiom side has one thread, where a for loop proves nothing.
    int result = threadPoolHammer(pool, times, #counter[0], counter.length);
    print("   hammered: " + itoa(result, 10) + " times across " +
          itoa(threadPoolThreads(pool), 10) + " threads\n");
    print("   counter:  " + itoa(@#counter[0], 10) + "\n");
    print("   exact:    " + itoa((@#counter[0] == times) as int, 10) + "\n");

    //  A second round onto the same cell: it must double exactly.
    threadPoolHammer(pool, times, #counter[0], counter.length);
    print("   after second round: " + itoa(@#counter[0], 10) +
          " (expect " + itoa(times * 2, 10) + ")\n");

    threadPoolDestroy(pool);
    eof: pass;
}

// ─── part 4: a pool vs one-shot threads ───────────────────────────────────

function private stageFour():void {
    print("\n4. why a pool: repeated reductions\n");
    print("   " + itoa(ROUNDS, 10) + " rounds of sum over " + itoa(N, 10) + " elements\n");

    int data[N] = {0};
    fillLcg(#data[0], N, 7u32);

    //  parallel reuses a pool inside too (since it went persistent), so this just checks
    //  agreement. Real numbers are in the docs: before pooling, parallel was slower.
    int64 pool = threadPoolCreate(0);

    int64 viaPool = 0;
    for (int r = 0; r < ROUNDS; r = r + 1) {
        viaPool = viaPool + threadPoolSum(pool, #data[0], N);
    }
    int64 viaParallel = 0;
    for (int r = 0; r < ROUNDS; r = r + 1) {
        viaParallel = viaParallel + parallelSumInt(#data[0], N, 0);
    }
    int64 viaSerial = 0;
    for (int r = 0; r < ROUNDS; r = r + 1) {
        viaSerial = viaSerial + parallelSumInt(#data[0], N, 1);
    }

    print("   pool total:     " + itoa(viaPool, 10) + "\n");
    print("   parallel total: " + itoa(viaParallel, 10) + "\n");
    print("   serial total:   " + itoa(viaSerial, 10) + "\n");
    print("   all agree:      " + itoa((viaPool == viaParallel && viaPool == viaSerial) as int, 10) +
          "\n");

    threadPoolDestroy(pool);

    //  ── on timing ──
    //
    //  Axiom has no clock builtin (time lives in the `time` library, reading the wall
    //  clock), so nothing here counts seconds — a fixed "the pool saved N ms" ages fast.
    //  For real numbers, time two runs with the shell, `parallelSumInt(..., 1)` then `...0`:
    //
    //      time acvm run examples/threadpool_demo.ax
    //
    //  The docs record before and after: before pooling, reducing 2M elements on 12
    //  threads was 20% slower than serial (1.41s → 1.69s); pooling ties it (0.44s → 0.45s).
    eof: pass;
}

function main():void {
    print("cpus: " + itoa(cpuCount(), 10) + "\n\n");
    stageOne();
    stageTwo();
    stageThree();
    stageFour();
    print("\ndone\n");
    eof: pass;
}
