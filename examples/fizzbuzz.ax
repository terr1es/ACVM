function main():void {
    for i in 1..16 {
        if (i % 15 == 0) {
            print("FizzBuzz\n");
        } else if (i % 3 == 0) {
            print("Fizz\n");
        } else if (i % 5 == 0) {
            print("Buzz\n");
        } else {
            print(itoa(i, 10) + "\n");
        }
    }
    eof: pass;
}
