function import (return:(io));

//  Branch-dense: a nested condition classified per iteration. Measures dispatch plus branch
//  prediction, with almost no arithmetic to hide behind.
function classify(int x):int {
    if (x < 0) { return -1; }
    if (x % 2 == 0) {
        if (x % 3 == 0) { return 2; }
        return 1;
    }
    if (x % 5 == 0) { return 3; }
    return 4;
    eof: pass;
}

function main():void {
    int acc = 0;
    for (int i = 0; i < 5000000; i++) {
        acc = acc + classify(i % 1000);
    }
    print(acc); print("\n");
    eof: pass;
}
