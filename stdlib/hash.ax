//  hash.ax — ASTL hash containers: HashSetInt / HashSetInt64 / HashMapInt / HashSetStr / HashMapStr.
//
//      function import (return:(hash));
//
//      HashSetInt s = makeHashSetInt(64);      // slots are rounded up to a power of two
//      hashSetIntAdd(#s, 42);
//      print(hashSetIntContains(#s, 42));      // true
//      hashSetIntFree(#s);
//
//  ── how this splits work with set.ax / map.ax ─────────────────────────────
//
//  Ordered containers (set/map) look up in O(log n), insert in O(n); hash containers do both
//  in O(1) on average but are **unordered** -- to walk in order, sort first. How to choose:
//
//  | requirement | use |
//  |---|---|
//  | frequent insert/delete + only "is it there" | hash |
//  | min/max, range scans, in-order walk | ordered |
//  | fewer than a few hundred elements | ordered (faster: no hash cost, cache friendly) |
//
//  ── implemented in C, reached through a handle ────────────────────────────
//
//  The slot arrays, the probe, the growth policy and the rehash all live in
//  stdlib/hash.c. What each container struct holds is one `int64` handle.
//
//  The reason is measured rather than stylistic. With the containers written in
//  Axiom, one `hashSetIntAdd` plus one `hashSetIntContains` cost about 370
//  bytecodes: the profile was LOAD_LOCAL 21%, CONST_INT 18%, STORE_LOCAL 11%,
//  which is the cost of dispatching a container in the language it is meant to
//  speed up. Moving only the probe loop got 2.6x and left 33x to CPython, whose
//  `set` is C.
//
//  A handle rather than a `ptr` because the two address spaces do not mix. The
//  VM's memory is separately allocated 64 KB pages, so a pointer into it is
//  meaningless to native code -- the compiler refuses `ptr` parameters with no
//  element count for exactly that reason. Memory hash.c allocates with `malloc`
//  is a different matter: it is in the process address space, and the `int64`
//  says "opaque number, only the C side knows what it points at".
//
//  Every function treats handle 0 as an unusable table and reports failure
//  rather than trapping, so a set whose allocation failed is useless, not fatal.
//
//  ── string keys are copied, and that fixes a lifetime bug ─────────────────
//
//  The previous implementation stored descriptor copies and documented that a key
//  declared inside an `arena_scope` dangled once the scope ended (AX01-M02). The
//  C table owns a byte copy of each key instead, so that restriction is gone: a
//  key may come from any temporary, and `hashSetStrFree` releases the copies.
//
//  ── open addressing + linear probing ──────────────────────────────────────
//
//  No per-node allocation: every slot lives in one contiguous array, and probing
//  is index +1 with a power-of-two mask. Delete uses a tombstone instead of
//  clearing, or the probe chain would be cut and a key that is present would not
//  be found. Tombstones are cleared on rehash.
//
//  Load factor ceiling is 0.75 counting tombstones; past that, grow and reinsert
//  the live keys.

module "hash" version "0.1.0";

//  Unpacks a `hashIntTake` / `hashStrTake` result.
//
//  Bit 32 carries the found flag; the low 32 bits are the value's bit pattern.
//  The widening happens inside `int64` on purpose: `(packed & 0xFFFFFFFF) as int`
//  would be a checked conversion from a value above 2^31 and would trap on every
//  negative stored value, which is not a rare case.
function private takeValueOf(int64 packed, ptr int out):bool {
    if ((packed >> 32i64) == 0i64) {
        return false;
    }
    if (out != 0 as ptr int) {
        int64 raw = packed & 4294967295i64;
        if (raw >= 2147483648i64) {
            raw = raw - 4294967296i64;
        }
        @out = raw as int;
    }
    return true;
    eof: pass;
}

// ─── HashSetInt ───────────────────────────────────────────────────────────

struct HashSetInt {
    int64 handle;
};

//  Creates an empty `int`-keyed hash set.
//
//  `requestedSlots` is a capacity hint in slots, rounded up to a power of two
//  with a floor of 8. `requestedSlots <= 0` yields an unusable set, and then every
//  add and lookup reports failure.
//
//  Grows automatically at 75% occupancy, counting tombstones as occupied.
function makeHashSetInt(int requestedSlots):HashSetInt {
    HashSetInt s = {hashIntCreate(requestedSlots)};
    return s;
    eof: pass;
}

//  Releases the slot arrays. Safe to call twice.
function hashSetIntFree(ptr HashSetInt s):void {
    hashIntDestroy(s->handle);
    s->handle = 0;
    eof: pass;
}

//  Inserts `value`, or overwrites it if present (unobservable for a set).
//
//  Returns true when the value is a member afterwards; false when the set is
//  unusable or allocation failed.
//  Amortised O(1); the table doubles once occupancy reaches 75%.
function hashSetIntAdd(ptr HashSetInt s, int value):bool {
    return hashIntPut(s->handle, value as int64, 0) != 0;
    eof: pass;
}

//  True when `value` is a member. Amortised O(1).
function hashSetIntContains(ptr HashSetInt s, int value):bool {
    return hashIntContains(s->handle, value as int64) != 0;
    eof: pass;
}

//  Removes `value`. Returns false when it was not present.
//
//  Deletion is logical: the slot becomes a tombstone rather than closing the probe
//  chain, so repeated add/remove cycles keep growing the table even when the
//  element count stays flat.
function hashSetIntRemove(ptr HashSetInt s, int value):bool {
    return hashIntRemove(s->handle, value as int64) != 0;
    eof: pass;
}

//  Number of live members. O(1); tombstones are not counted.
function hashSetIntCount(ptr HashSetInt s):int {
    return hashIntCount(s->handle);
    eof: pass;
}

//  Slot capacity, never below the live count. Diagnostic: a set that keeps
//  growing while its count stays flat has accumulated tombstones.
function hashSetIntSlots(ptr HashSetInt s):int {
    return hashIntSlots(s->handle);
    eof: pass;
}

// ─── HashSetInt64 ─────────────────────────────────────────────────────────

struct HashSetInt64 {
    int64 handle;
};

//  Creates an empty `int64`-keyed hash set. Same capacity rules as
//  `makeHashSetInt`.
function makeHashSetInt64(int requestedSlots):HashSetInt64 {
    HashSetInt64 s = {hashIntCreate(requestedSlots)};
    return s;
    eof: pass;
}

//  Releases the slot arrays. Safe to call twice.
function hashSetInt64Free(ptr HashSetInt64 s):void {
    hashIntDestroy(s->handle);
    s->handle = 0;
    eof: pass;
}

//  Inserts `value`. Returns true when it is a member afterwards.
function hashSetInt64Add(ptr HashSetInt64 s, int64 value):bool {
    return hashIntPut(s->handle, value, 0) != 0;
    eof: pass;
}

//  True when `value` is a member. Amortised O(1).
function hashSetInt64Contains(ptr HashSetInt64 s, int64 value):bool {
    return hashIntContains(s->handle, value) != 0;
    eof: pass;
}

//  Removes `value`. Returns false when it was not present.
function hashSetInt64Remove(ptr HashSetInt64 s, int64 value):bool {
    return hashIntRemove(s->handle, value) != 0;
    eof: pass;
}

//  Number of live members. O(1).
function hashSetInt64Count(ptr HashSetInt64 s):int {
    return hashIntCount(s->handle);
    eof: pass;
}

// ─── HashMapInt ───────────────────────────────────────────────────────────

struct HashMapInt {
    int64 handle;
};

//  Creates an empty `int -> int` hash map. Same capacity rules as
//  `makeHashSetInt`.
function makeHashMapInt(int requestedSlots):HashMapInt {
    HashMapInt m = {hashIntCreateMap(requestedSlots)};
    return m;
    eof: pass;
}

//  Releases the slot arrays. Safe to call twice.
function hashMapIntFree(ptr HashMapInt m):void {
    hashIntDestroy(m->handle);
    m->handle = 0;
    eof: pass;
}

//  Inserts or overwrites `key`. Returns true on success, false when the map is
//  unusable or allocation failed.
//  Amortised O(1); overwriting an existing key does not grow the table.
function hashMapIntPut(ptr HashMapInt m, int key, int value):bool {
    return hashIntPut(m->handle, key as int64, value) != 0;
    eof: pass;
}

//  Looks up `key`. Returns true and writes `*out` on a hit; returns false on a
//  miss and **leaves `*out` untouched** -- always branch on the return value, not
//  on the previous contents of `out`. Pass a null `out` to test membership
//  without reading the value.
function hashMapIntGet(ptr HashMapInt m, int key, ptr int out):bool {
    return takeValueOf(hashIntTake(m->handle, key as int64), out);
    eof: pass;
}

//  True when `key` is present. Amortised O(1), and cheaper than `hashMapIntGet`
//  when the value is not needed.
function hashMapIntHas(ptr HashMapInt m, int key):bool {
    return hashIntContains(m->handle, key as int64) != 0;
    eof: pass;
}

//  Removes `key`. Returns false when it was not present. Leaves a tombstone.
function hashMapIntRemove(ptr HashMapInt m, int key):bool {
    return hashIntRemove(m->handle, key as int64) != 0;
    eof: pass;
}

//  Number of live entries. O(1).
function hashMapIntCount(ptr HashMapInt m):int {
    return hashIntCount(m->handle);
    eof: pass;
}

// ─── HashSetStr ───────────────────────────────────────────────────────────

struct HashSetStr {
    int64 handle;
};

//  Creates an empty `string`-keyed hash set.
//
//  Same `requestedSlots` rules as `makeHashSetInt`. Keys are compared by content
//  and the set keeps its own copy of each key's bytes, so a key may come from any
//  temporary -- an `arena_scope` that has since ended included.
function makeHashSetStr(int requestedSlots):HashSetStr {
    HashSetStr s = {hashStrCreate(requestedSlots)};
    return s;
    eof: pass;
}

//  Releases the slot arrays and the copies of the keys. Safe to call twice.
function hashSetStrFree(ptr HashSetStr s):void {
    hashStrDestroy(s->handle);
    s->handle = 0;
    eof: pass;
}

//  Inserts `value`, comparing contents (byte-wise) rather than descriptors.
//  Returns true when it is a member afterwards, false on allocation failure.
//  Amortised O(1) probes, each comparison O(key length).
function hashSetStrAdd(ptr HashSetStr s, string key):bool {
    return hashStrPut(s->handle, key, 0) != 0;
    eof: pass;
}

//  True when `value` is a member, comparing contents. Amortised O(1) probes.
function hashSetStrContains(ptr HashSetStr s, string key):bool {
    return hashStrContains(s->handle, key) != 0;
    eof: pass;
}

//  Removes `value`. Returns false when it was not present.
//  Leaves a tombstone; the key copy is released when the set is freed.
function hashSetStrRemove(ptr HashSetStr s, string key):bool {
    return hashStrRemove(s->handle, key) != 0;
    eof: pass;
}

//  Number of live members. O(1).
function hashSetStrCount(ptr HashSetStr s):int {
    return hashStrCount(s->handle);
    eof: pass;
}

//  Slot capacity, never below the live count. Diagnostic.
function hashSetStrSlots(ptr HashSetStr s):int {
    return hashStrSlots(s->handle);
    eof: pass;
}

// ─── HashMapStr ───────────────────────────────────────────────────────────

struct HashMapStr {
    int64 handle;
};

//  Creates an empty `string -> int` hash map.
//  Same `requestedSlots` rules as `makeHashSetInt`, and keys are copied rather
//  than borrowed.
function makeHashMapStr(int requestedSlots):HashMapStr {
    HashMapStr m = {hashStrCreate(requestedSlots)};
    return m;
    eof: pass;
}

//  Releases the slot arrays and the copies of the keys. Safe to call twice.
function hashMapStrFree(ptr HashMapStr m):void {
    hashStrDestroy(m->handle);
    m->handle = 0;
    eof: pass;
}

//  Inserts or overwrites `key` (`string` -> `int`), comparing key contents.
//  Returns true on success, false when the map is unusable or allocation failed.
function hashMapStrPut(ptr HashMapStr m, string key, int value):bool {
    return hashStrPut(m->handle, key, value) != 0;
    eof: pass;
}

//  Looks up `key` (`string` -> `int`). Returns true and writes `*out` on a hit;
//  false on a miss with `*out` untouched.
function hashMapStrGet(ptr HashMapStr m, string key, ptr int out):bool {
    return takeValueOf(hashStrTake(m->handle, key), out);
    eof: pass;
}

//  True when `key` is present. Amortised O(1).
function hashMapStrHas(ptr HashMapStr m, string key):bool {
    return hashStrContains(m->handle, key) != 0;
    eof: pass;
}

//  Removes `key`. Returns false when it was not present. Leaves a tombstone.
function hashMapStrRemove(ptr HashMapStr m, string key):bool {
    return hashStrRemove(m->handle, key) != 0;
    eof: pass;
}

//  Number of live entries. O(1).
function hashMapStrCount(ptr HashMapStr m):int {
    return hashStrCount(m->handle);
    eof: pass;
}
